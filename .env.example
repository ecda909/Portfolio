
# --- Platform baseline (commented out on purpose) ---
# .env.example is this app's deploy allowlist, not documentation. Every
# UNCOMMENTED key becomes an entry in the ExternalSecret, and one entry with
# no value in Parameter Store fails the whole secret -- no pod starts.
# Uncomment a key in the SAME change that gives it a value:
#   blankcut secrets set <KEY> <value> --app <app>
# DATABASE_URL=
# REDIS_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# RESEND_API_KEY=
# NEXT_PUBLIC_APP_URL=
